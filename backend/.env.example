# Configuración local del backend (copiar a backend/.env; .env no se versiona).
# La lee app/config.py (pydantic-settings) al arrancar desde backend/.
#
# Copia de desarrollo en 3100/8100, junto a la oficina diaria en 3000/8000:
#   cp backend/.env.example backend/.env
#   make dev-local   # desde la raíz
# El puerto del backend NO va aquí: lo fija el Makefile (BACKEND_PORT, por defecto 8000;
# make dev-local usa 8100).

# Orígenes del frontend de desarrollo (localhost, 127.0.0.1 e IP de Tailscale de la PC).
BACKEND_CORS_ORIGINS=["http://localhost:3100","http://127.0.0.1:3100","http://<TAILSCALE_IP>:3100","http://localhost:8100","http://127.0.0.1:8100"]

# Sin resúmenes con IA en desarrollo (no gasta tokens; usa texto local).
SUMMARY_BACKEND=disabled

# Inicio de sesión y máquinas (etapa 1.1). En local queda desactivado: todo funciona
# como antes (hooks sin token, iPhone por Tailscale). Para producción ver
# .env.produccion.example y PROJECT.md, sección "Inicio de sesión y máquinas".
VISUALIZADOR_AUTH=desactivado
