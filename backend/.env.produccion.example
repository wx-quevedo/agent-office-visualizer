# Configuración de producción del backend (VPS de the VPS provider, https://agents.example.com).
# Etapa 1.1: preparada, sin desplegar (el despliegue es la etapa 1.3). Copiar a
# backend/.env en el servidor y completar los valores marcados. Nunca versionar el .env real.

# -- Acceso -------------------------------------------------------------------------
# Todo exige sesión (cookie o token de app) o token de máquina (ingesta).
VISUALIZADOR_AUTH=activado
# Clave de los hashes de los tokens (HMAC-SHA256). Generar una sola vez, por ejemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Cambiarla invalida todas las sesiones y todos los tokens de máquina.
VISUALIZADOR_SECRETO=COMPLETAR
# nginx termina https y reenvía a 127.0.0.1:8000: se confía en X-Forwarded-For
# (límite de intentos por IP real) y X-Forwarded-Proto (cookie segura).
CONFIAR_PROXY=true
# La cookie de sesión siempre con Secure en producción.
COOKIE_SEGURA=si

# -- Dominio y orígenes -----------------------------------------------------------------
# El frontend y la API se sirven desde el mismo dominio (nginx): solo ese origen.
BACKEND_CORS_ORIGINS=["https://agents.example.com"]

# -- Datos (fuera del repositorio) -----------------------------------------------------------
# Registro del motor; junto a él quedan permisos.db, permisos.json, distribucion.json,
# acceso.db (usuario, sesiones, máquinas y tokens) y respaldos/.
STATE_EVENT_LOG_PATH=/srv/visualizador/datos/agent_events.db
DATABASE_URL=sqlite+aiosqlite:////srv/visualizador/datos/visualizer.db
# Opcionales (por defecto, junto al registro del motor):
# ACCESO_DB_PATH=/srv/visualizador/datos/acceso.db
# RESPALDOS_PATH=/srv/visualizador/respaldos

# -- Máquina de los datos ya existentes ----------------------------------------------------
# Los eventos sin token de máquina (solo en modo desactivado) y los datos migrados
# desde la PC quedan en esta máquina.
MAQUINA_LOCAL_ID=alienware
MAQUINA_LOCAL_NOMBRE=Alienware
MAQUINA_LOCAL_SISTEMA=windows

# -- Otros ---------------------------------------------------------------------------
LOG_RICH_TRACEBACKS=false
