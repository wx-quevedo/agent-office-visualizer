{
  "name": "frontend",
  "version": "0.24.1",
  "//": [
    "Dependency policy (ARC-027, 2026-07): runtime `dependencies` are exact-pinned",
    "for reproducible builds; `devDependencies` use caret ranges so build tools",
    "float within minor.",
    "`overrides`: all @typescript-eslint/* sub-packages pinned to 8.70.0 to match",
    "the typescript-eslint umbrella. eslint-config-next 16.3.5 permits ^8.46.0 of",
    "the umbrella; without these pins, transitive resolution can mix 8.4x-era",
    "sub-packages with the 8.70.0 umbrella and crash lint rules. Re-evaluate on",
    "the next eslint-config-next upgrade.",
    "`typescript` held at ^6.0.3 (latest 6.x): typescript-eslint has no TS 7",
    "support yet (peer range <6.1.0) and typescript-estree crashes on TS 7.",
    "`eslint` held at ^9.39.5 (latest 9.x): eslint-plugin-react 7.37.5 (declared",
    "by eslint-config-next) peers up to ^9.7 only and crashes on eslint 10."
  ],
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@pixi/react": "8.0.5",
    "@xstate/react": "6.1.0",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.46.0",
    "next": "16.3.5",
    "pixi.js": "8.20.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-zoom-pan-pinch": "4.2.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "xstate": "5.33.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-types": "^1.4.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "typescript-eslint": "8.70.0",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "@typescript-eslint/utils": "8.70.0",
    "@typescript-eslint/types": "8.70.0",
    "@typescript-eslint/typescript-estree": "8.70.0",
    "@typescript-eslint/scope-manager": "8.70.0",
    "@typescript-eslint/visitor-keys": "8.70.0",
    "@typescript-eslint/type-utils": "8.70.0",
    "@typescript-eslint/project-service": "8.70.0",
    "@typescript-eslint/tsconfig-utils": "8.56.1"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
