# Configuración local del frontend (copiar a frontend/.env.local; no se versiona).
#
# Copia de desarrollo en 3100/8100, junto a la oficina diaria en 3000/8000:
#   cp frontend/.env.example frontend/.env.local
#   make dev-local   # desde la raíz
# El puerto del servidor de Next lo fija el Makefile (FRONTEND_PORT, por defecto 3000;
# make dev-local usa 3100).

# Puerto del backend. El frontend lo busca en http://<host de la página>:<puerto>.
# Por defecto 8000. NEXT_PUBLIC_API_URL y NEXT_PUBLIC_WS_URL, si existen, tienen prioridad.
NEXT_PUBLIC_BACKEND_PORT=8100

# Hosts extra que pueden abrir el servidor de desarrollo de Next (allowedDevOrigins),
# separados por comas; por ejemplo la IP de Tailscale de la PC para entrar desde el iPhone.
ALLOWED_DEV_ORIGINS=<TAILSCALE_IP>
